# Production environment template
SCHOOL_ERP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SCHOOL_ERP_SECURE_COOKIES=1
SCHOOL_ERP_AUTO_CREATE_DB=0
SCHOOL_ERP_MAX_UPLOAD_MB=10
# Example PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://schoolerp:CHANGE_ME@db:5432/schoolerp
# Keep schema auto-upgrade disabled in production after the approved migration has been applied.
SCHOOL_ERP_AUTO_SCHEMA_UPGRADE=0
